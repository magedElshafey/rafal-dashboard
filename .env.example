VITE_API_BASE_URL=
# Temporary local-only bypass; set to false when the Laravel auth contract is available.
VITE_AUTH_BYPASS=true
# Temporary Roles CRUD transport. Set to false to use the configured Laravel API.
VITE_ROLES_USE_MOCK=true
# Temporary Admins CRUD transport. Set to false to use the configured Laravel API.
VITE_ADMINS_USE_MOCK=true
VITE_BANNERS_USE_MOCK=true
VITE_CATEGORIES_USE_MOCK=true
VITE_WAREHOUSES_USE_MOCK=true
VITE_REGIONS_USE_MOCK=true
VITE_CITIES_USE_MOCK=true
VITE_SETTINGS_USE_MOCK=true
# Public, browser-safe MapLibre style JSON URL. Development falls back to this OpenFreeMap Liberty style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_REACT_APP_DEFAULT_LOCALE=ar
VITE_REACT_APP_THEME_KEY=theme
VITE_REACT_APP_LOCALE_STORAGE_KEY=locale
