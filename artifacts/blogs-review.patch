+              'excerpt[ar]': 'excerpt.ar',
+              body: 'body.ar',
+              'body.ar': 'body.ar',
+              'body.en': 'body.en',
+              'body[ar]': 'body.ar',
+              author_name: 'authorName',
+              is_featured: 'isFeatured',
