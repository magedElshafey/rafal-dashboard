+import { useQuery } from '@tanstack/react-query'
+
+import { loyaltyService } from '@/modules/loyalty/api/loyalty.service'
+import { loyaltyKeys } from '@/modules/loyalty/queries/loyalty.keys'
+import type { LoyaltyLedgerFilters } from '@/modules/loyalty/types/loyalty.types'
+import { getLoyaltyLedgerDateState } from '@/modules/loyalty/utils/loyalty-ledger'
+
+export function useCustomerLoyaltyLedger(customerId: number, filters: LoyaltyLedgerFilters, enabled: boolean) {
+  return useQuery({
+    queryKey: loyaltyKeys.customerLedger(customerId, filters),
+    queryFn: ({ signal }) => loyaltyService.getCustomerLedger(customerId, filters, signal),
+    enabled: enabled && getLoyaltyLedgerDateState(filters) === 'valid',
+    retry: false,
+  })
+}

diff --git a/src/modules/loyalty/utils/loyalty-ledger.test.ts b/src/modules/loyalty/utils/loyalty-ledger.test.ts
new file mode 100644
index 0000000..95ac55a
--- /dev/null
+++ b/src/modules/loyalty/utils/loyalty-ledger.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest'
+
+import { getLoyaltyLedgerDateState, readLoyaltyLedgerFilters, serializeLoyaltyLedgerFilters } from './loyalty-ledger'
+
+describe('loyalty ledger filters', () => {
+  it('accepts only the documented type and complete valid date ranges', () => {
+    expect(readLoyaltyLedgerFilters({ type: 'unknown', from: '2026-11-01', to: '2026-11-30' })).toEqual({
+      type: null,
+      from: '2026-11-01',
+      to: '2026-11-30',
+    })
+    expect(getLoyaltyLedgerDateState({ type: null, from: '2026-11-01', to: '' })).toBe('incomplete')
+    expect(getLoyaltyLedgerDateState({ type: null, from: '2026-12-01', to: '2026-11-30' })).toBe('invalid')
+    expect(getLoyaltyLedgerDateState({ type: null, from: '2026-11-01', to: '2026-11-30' })).toBe('valid')
+  })
+
+  it('never serializes incomplete date ranges or unsupported values', () => {
+    expect(serializeLoyaltyLedgerFilters({ type: null, from: '2026-11-01', to: '' })).toEqual({})
+    expect(serializeLoyaltyLedgerFilters({ type: 'adjust_credit', from: '2026-11-01', to: '2026-11-30' })).toEqual({
+      type: 'adjust_credit',
+      from: '2026-11-01',
+      to: '2026-11-30',
+    })
+  })
+})

diff --git a/src/modules/loyalty/utils/loyalty-ledger.ts b/src/modules/loyalty/utils/loyalty-ledger.ts
new file mode 100644
index 0000000..664d4bf
--- /dev/null
+++ b/src/modules/loyalty/utils/loyalty-ledger.ts
@@ -0,0 +1,37 @@
+import type { QueryRecord } from '@/store/queryContext/types'
+import { isValidDateInput } from '@/utils/date/date.helpers'
+import type { LoyaltyLedgerFilters } from '@/modules/loyalty/types/loyalty.types'
+
+const DATE_PATTERN = /^\d{4}-\d{2}-\d{2}$/
+
+export const emptyLoyaltyLedgerFilters: LoyaltyLedgerFilters = { type: null, from: '', to: '' }
+
+export function readLoyaltyLedgerFilters(query: QueryRecord): LoyaltyLedgerFilters {
+  return {
+    type: query?.type === 'adjust_credit' ? 'adjust_credit' : null,
+    from: query?.from ?? '',
+    to: query?.to ?? '',
+  }
+}
+
+export function getLoyaltyLedgerDateState(filters: LoyaltyLedgerFilters): 'valid' | 'incomplete' | 'invalid' {
+  if (!filters.from && !filters.to) return 'valid'
+  if (!filters.from || !filters.to) return 'incomplete'
+  if (
+    !DATE_PATTERN.test(filters.from) ||
+    !DATE_PATTERN.test(filters.to) ||
+    !isValidDateInput(filters.from) ||
+    !isValidDateInput(filters.to) ||
+    filters.from > filters.to
+  ) {
+    return 'invalid'
+  }
+  return 'valid'
+}
+
+export function serializeLoyaltyLedgerFilters(filters: LoyaltyLedgerFilters) {
+  return {
+    ...(filters.type ? { type: filters.type } : {}),
+    ...(filters.from && filters.to ? { from: filters.from, to: filters.to } : {}),
+  }
+}

