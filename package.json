    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.4.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "html-react-parser": "^6.1.5",
    "i18next": "^23.7.16",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.516.0",
    "maplibre-gl": "6.10.0",
    "react": "^19.2.3",
