    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "6.4.3",
    "vitest": "3.2.6",
    "yup": "^1.6.1"
  },
  "resolutions": {
    "js-yaml": ">=4.1.1"
  }
}
