diff --git a/src/modules/loyalty/schemas/loyalty-adjustment.schema.test.ts b/src/modules/loyalty/schemas/loyalty-adjustment.schema.test.ts
new file mode 100644
index 0000000..d1b2fca
--- /dev/null
+++ b/src/modules/loyalty/schemas/loyalty-adjustment.schema.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest'
+
+import { createLoyaltyAdjustmentSchema } from './loyalty-adjustment.schema'
+
+const schema = (available: number | null = 100) =>
+  createLoyaltyAdjustmentSchema(
+    {
+      required: 'required',
+      integer: 'integer',
+      pointsRange: 'range',
+      noteLength: 'note',
+      insufficientBalance: 'insufficient',
+    },
+    available
+  )
+
+const valid = {
+  type: 'credit',
+  points: 10,
+  reason: 'customer_service',
+  note: 'A valid internal note',
+  notifyCustomer: false,
+}
+
+describe('loyalty adjustment validation', () => {
+  it('accepts documented credit and debit values without changing the note', async () => {
+    await expect(schema().validate(valid)).resolves.toEqual(valid)
+    await expect(schema().validate({ ...valid, type: 'debit', points: 100, reason: 'other' })).resolves.toMatchObject({
+      type: 'debit',
+      points: 100,
+      reason: 'other',
+    })
+  })
+
+  it.each([0, -1, 1.5, 100001])('rejects invalid points %s', async (points) => {
+    await expect(schema().validate({ ...valid, points })).rejects.toThrow()
+  })
+
+  it('rejects unsupported reasons and notes outside 10-250 trimmed characters', async () => {
+    await expect(schema().validate({ ...valid, reason: 'refund' })).rejects.toThrow('required')
+    await expect(schema().validate({ ...valid, note: ' short ' })).rejects.toThrow('note')
+    await expect(schema().validate({ ...valid, note: 'x'.repeat(251) })).rejects.toThrow('note')
+  })
+
+  it('blocks a known over-balance debit but leaves unknown balance authority to the backend', async () => {
+    await expect(schema(100).validate({ ...valid, type: 'debit', points: 101 })).rejects.toThrow('insufficient')
+    await expect(schema(null).validate({ ...valid, type: 'debit', points: 101 })).resolves.toMatchObject({
+      points: 101,
+    })
+  })
+})
diff --git a/src/modules/loyalty/schemas/loyalty-adjustment.schema.ts b/src/modules/loyalty/schemas/loyalty-adjustment.schema.ts
new file mode 100644
index 0000000..70c586a
--- /dev/null
+++ b/src/modules/loyalty/schemas/loyalty-adjustment.schema.ts
@@ -0,0 +1,43 @@
+import * as yup from 'yup'
+
+import type { LoyaltyAdjustmentFormValues } from '@/modules/loyalty/types/loyalty.types'
+
+export type LoyaltyAdjustmentValidationMessages = {
+  required: string
+  integer: string
+  pointsRange: string
+  noteLength: string
+  insufficientBalance: string
+}
+
+export function createLoyaltyAdjustmentSchema(
+  messages: LoyaltyAdjustmentValidationMessages,
+  availablePoints: number | null
+) {
+  return yup.object<LoyaltyAdjustmentFormValues>({
+    type: yup.mixed<'credit' | 'debit'>().oneOf(['credit', 'debit'], messages.required).required(messages.required),
+    points: yup
+      .number()
+      .transform((value, originalValue) => (originalValue === '' || originalValue === null ? Number.NaN : value))
+      .typeError(messages.required)
+      .required(messages.required)
+      .integer(messages.integer)
+      .min(1, messages.pointsRange)
+      .max(100000, messages.pointsRange)
+      .test('available-balance', messages.insufficientBalance, function (value) {
+        return this.parent.type !== 'debit' || availablePoints === null || value <= availablePoints
+      }),
+    reason: yup
+      .mixed<'customer_service' | 'other'>()
+      .oneOf(['customer_service', 'other'], messages.required)
+      .required(messages.required),
+    note: yup
+      .string()
+      .required(messages.required)
+      .test('note-length', messages.noteLength, (value) => {
+        const length = value?.trim().length ?? 0
+        return length >= 10 && length <= 250
+      }),
+    notifyCustomer: yup.boolean().required(messages.required).defined(),
+  })
+}
